package templates

// Layout is the chrome around every page. There are no inline scripts and no
// external origins: the GUI must work on an air-gapped laptop under a strict
// content security policy.
//
// The appearance settings are data attributes on the root element rather than
// a different stylesheet, so a page arrives already themed and nothing
// flashes on load.
templ Layout(p PageView) {
	<!DOCTYPE html>
	<html lang={ string(p.Lang) } { p.Theme.HTMLAttrs()... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title } · otinv</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/vendor/htmx.min.js" defer></script>
		</head>
		<body>
			<header class="topbar">
				<a class="brand" href="/">otinv</a>
				if p.Project != "" {
					<span class="project">{ p.Project }</span>
				}
				<nav>
					for _, item := range NavItems(p.Lang) {
						<a href={ templ.SafeURL(item.Href) } class={ navClass(p.Nav, item.Key) }>
							{ item.Label }
						</a>
					}
				</nav>
			</header>
			<main>
				{ children... }
			</main>
			<footer>{ T(p.Lang, "footer.passive") }</footer>
		</body>
	</html>
}

func navClass(active, item string) string {
	if active == item {
		return "nav-item active"
	}
	return "nav-item"
}
